# ==========================================
# VARIABLES DE ENTORNO DE PRODUCCIÓN - DNA MUSIC
# Copiar este archivo como '.env' en la raíz antes de levantar Docker Compose:
# cp .env.prod.example .env
# ==========================================

# --- CONFIGURACIÓN DE BASE DE DATOS POSTGRES ---
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=dnamusic
DB_PORT=5432

# --- PUERTOS EXPUESTOS ---
# Puerto del Backend en el host (puedes cambiarlo si el puerto 3000 está ocupado)
BACKEND_PORT=3000

# Puerto del Frontend en el host (puerto 80 es estándar para HTTP, pero puedes cambiarlo)
FRONTEND_PORT=80

# --- SEGURIDAD Y JWT ---
# CAMBIA ESTE SECRET POR ALGO SEGURO EN PRODUCCIÓN
JWT_SECRET=dna-music-jwt-secret-change-in-production-2024
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# --- CONTROLADORES DE INICIO ---
# Indica si el backend debe poblar la base de datos con los datos semilla la primera vez
RUN_SEED=true

# --- DIRECCIONES EXTERNAS (CORS Y FRONTEND) ---
# CORS_ORIGIN debe ser el origen desde el cual los usuarios accederán al Frontend
CORS_ORIGIN=http://localhost

# VITE_API_URL debe ser la URL o dominio base público de la aplicación (SIN /api al final).
# Si estás probando localmente con Docker Compose: http://localhost
# Si usas un dominio o IP del servidor: https://dnamusic.sol-tec-in.com o http://<IP_SERVIDOR>
# Nota: La aplicación de Axios le agregará automáticamente el sufijo /api de manera interna.
VITE_API_URL=http://localhost

# --- SERVICIO DE CORREO SMTP (Nodemailer) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password_de_16_digitos
EMAIL_FROM="DNA Music Academy <tu_correo@gmail.com>"
